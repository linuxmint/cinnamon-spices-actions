[Nemo Action]
_Name=Copy path to clipboard
_Comment=Copy the full path of the selected item to the clipboard
Exec=/usr/bin/env bash -c '$HOME/.local/share/nemo/actions/copy-path-to-clipboard@claudiux/copy-pah.sh %F %U'
Selection=notnone
Extensions=any
Quote=double
EscapeSpaces=true
Icon-Name=edit-copy
Dependencies=xclip;
